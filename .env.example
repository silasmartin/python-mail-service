# --- Shared SMTP defaults (optional when every domain overrides them) ---
MAIL_SERVER="<add_mailserver_here>"
MAIL_PORT="587"
MAIL_USE_TLS="true"
MAIL_USE_SSL="false"
MAIL_USERNAME="<add_username_here>"
MAIL_PASSWORD="<add_password_here>"
MAIL_DEFAULT_SENDER="<add_sender_address_here>"

# --- Per-domain routing, CAPTCHA and optional SMTP credentials (required) ---
# Keep this JSON on one line for compatibility with Docker Compose env_file.
# A domain's smtp object overrides any shared MAIL_* defaults above and accepts
# server, port, use_tls, use_ssl, username, password and default_sender - each
# one optional. Setting use_tls or use_ssl picks that domain's transport
# outright, so an SSL domain needs only {"port":465,"use_ssl":true}. Example
# with a fully custom mail server:
# {"yourdomain.com":{"recipients":["you@yourdomain.com"],"captcha_secret":"at-least-32-random-characters-long","smtp":{"server":"smtp.yourdomain.com","port":465,"use_ssl":true,"username":"website@yourdomain.com","password":"secret","default_sender":"Website <website@yourdomain.com>"}}}
DOMAIN_CONFIG='{"silasmartin.de":{"recipients":["mail@silasmartin.de"],"captcha_secret":"replace-with-sms-website-secret-at-least-32-chars"},"gschwindt-galabau.de":{"recipients":["kontakt@gschwindt-galabau.de"],"captcha_secret":"replace-with-gschwindt-website-secret-at-least-32-chars"}}'

# --- CORS (required for cross-origin browser submissions) ---
# Comma-separated list of allowed origins. Same-origin proxying needs no CORS.
CORS_ORIGINS="https://silasmartin.de,https://gschwindt-galabau.de"

# --- Telegram operational alerts (optional) ---
# Alerts the operator when the service itself has a problem (e.g. SMTP delivery
# failed). Deliberately carries no form data, no recipient addresses and no
# exception messages - only the domain and the exception type. Blank = disabled.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Misc (optional) ---
LOG_LEVEL="INFO"
# Holds the CAPTCHA replay database and, only when SMTP delivery fails, the
# buffered submissions under <DATA_DIR>/failed/.
DATA_DIR="/usr/src/app/data"

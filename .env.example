# --- SMTP (required) ---
MAIL_SERVER="<add_mailserver_here>"
MAIL_PORT="587"
MAIL_USE_TLS="true"
MAIL_USE_SSL="false"
MAIL_USERNAME="<add_username_here>"
MAIL_PASSWORD="<add_password_here>"
MAIL_DEFAULT_SENDER="<add_sender_address_here>"

# --- Routing (required) ---
# JSON object mapping a domain (matched against the request Referer) to the
# recipient address(es) that should receive the notification.
DOMAIN_EMAIL_MAP='{"yourdomain.com": ["you@yourdomain.com"]}'

# --- CORS (required for browser form submissions) ---
# Comma-separated list of allowed origins. Empty = no cross-origin requests.
CORS_ORIGINS="https://yourdomain.com"

# --- Telegram notifications (optional) ---
TELEGRAM_BOT_TOKEN="<your_bot_token>"
TELEGRAM_CHAT_ID="<your_chat_id>"

# --- Misc (optional) ---
LOG_LEVEL="INFO"
DATA_DIR="/usr/src/app/data"
